{
  "name": "eslint-config-re",
  "version": "1.1.0",
  "main": "index.js",
  "description": "Shareable ESLint preset family with strict entry, essential (lax) overlay, and TypeScript/React/Vue/Node flavors",
  "keywords": [
    "eslint",
    "eslint-config",
    "typescript",
    "react",
    "vue",
    "node",
    "shareable-config",
    "lint"
  ],
  "scripts": {
    "lint": "eslint ./",
    "test": "node ./__tests__/smoke.js && mocha ./__tests__/*.test.js --timeout 5000 && node ./__tests__/smoke-cli.js",
    "print-config": "eslint --print-config ./index.js > ./print-config.json"
  },
  "author": "baihong",
  "homepage": "https://github.com/Graham-Sun/re-spec/tree/main/packages/eslint-config#readme",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Graham-Sun/re-spec.git",
    "directory": "packages/eslint-config"
  },
  "bugs": {
    "url": "https://github.com/Graham-Sun/re-spec/issues"
  },
  "files": [
    "index.js",
    "es5.js",
    "node.js",
    "react.js",
    "vue.js",
    "jsx-a11y.js",
    "README.md",
    "LICENSE",
    "essential/**/*.js",
    "rules/**/*.js",
    "typescript/**/*.js"
  ],
  "engines": {
    "node": ">=14"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "eslint": "^8.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.16.0",
    "@babel/eslint-parser": "^7.16.3",
    "@babel/preset-react": "^7.16.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.7.0",
    "eslint-config-egg": "^10.0.0",
    "eslint-import-resolver-typescript": "^2.5.0",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jsx-a11y": "^6.3.1",
    "eslint-plugin-jsx-plus": "^0.1.0",
    "eslint-plugin-react": "^7.17.0",
    "eslint-plugin-react-hooks": "^4.2.0",
    "eslint-plugin-vue": "^7.3.0",
    "lodash": "^4.17.21",
    "mocha": "^8.2.1",
    "typescript": "^4.1.2",
    "vue-eslint-parser": "^7.3.0"
  },
  "gitHead": "8b5c4f7f84213b6c4f14d40cb77b8135ae73e0f6"
}